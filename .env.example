# Supabase (database only — not used for user authentication)
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI (server-side only)
OPENAI_API_KEY=

# Public URL of this app (widget script + embed iframe)
# Production: https://ask.alicia.insure — local dev: http://localhost:3000
NEXT_PUBLIC_APP_URL=https://ask.alicia.insure

# Auth.js / NextAuth (Google Workspace SSO — same pattern as Gold/Kalinda)
AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional legacy alias
NEXTAUTH_SECRET=
AUTH_URL=

# Optional: skip auth locally only (never use in production)
# DEMO_MODE=true

# Optional: comma-separated emails allowed in admin (must still be @alicia.insure)
ALICIA_AI_ADMIN_EMAILS=
